{
  "name": "stock-opname",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/unit/*.test.js test/ui/*.test.js",
    "test:integration": "node scripts/test-integration.js",
    "test:security": "node --test test/security/*.test.js",
    "backup": "node scripts/backup.js",
    "restore:verify": "node scripts/restore.js",
    "lint": "find src scripts test -name '*.js' -type f -print0 | sort -z | xargs -0 -n1 node --check",
    "build": "find src -name '*.js' -type f -print0 | sort -z | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
